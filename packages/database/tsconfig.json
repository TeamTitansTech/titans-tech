{
  "extends": "@titans-tech/tsconfig/base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "module": "commonjs",
    "target": "ES2021",
    "declaration": true,
    "declarationMap": true,
    "typeRoots": ["./node_modules/@types", "../../node_modules/@types"]
  },
  "include": ["index.ts", "client.ts", "client-safe.ts", "enums.ts"],
  "exclude": ["node_modules", "dist", "prisma"]
}
