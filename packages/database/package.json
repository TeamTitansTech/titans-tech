{
  "name": "@titans-tech/db",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./client": {
      "require": "./dist/client-safe.js",
      "import": "./dist/client-safe.js",
      "types": "./dist/client-safe.d.ts"
    },
    "./enums": {
      "require": "./dist/enums.js",
      "import": "./dist/enums.js",
      "types": "./dist/enums.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "echo 'No lint configured for database package'",
    "db:generate": "prisma generate < /dev/null && tsc",
    "db:push": "prisma db push",
    "db:reset": "prisma migrate reset --force",
    "db:reset:force": "prisma db push --force-reset && tsx prisma/seed.ts",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:create-sys-admin": "tsx scripts/create-sys-admin.ts",
    "db:create-test-user": "tsx scripts/create-test-user.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@titans-tech/tsconfig": "*",
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "prisma": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
