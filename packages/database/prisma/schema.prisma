model ClutchData {
  id String @id @default(cuid())

  // Clutch Type and Location
  clutchType     ClutchType?
  clutchLocation ClutchLocation?

  // Brake Spring Settings (in inches)
  brakeSpringBrake    Decimal?                 @db.Decimal(10, 6)
  brakeSpringClutch   Decimal?                 @db.Decimal(10, 6)
  brakeSpringFB       Decimal?                 @db.Decimal(10, 6)
  brakeSpringFTB      Decimal?                 @db.Decimal(10, 6)
  brakeSpringRTB      Decimal?                 @db.Decimal(10, 6)
  brakeSpringStudBolt BrakeSpringStudBoltType?

  // Brake measurements
  brakeStoppingTime   Decimal?         @db.Decimal(10, 6)
  brakeLining         BrakeLiningType?
  brakeClearing       Decimal?         @db.Decimal(10, 6)
  brakeClearanceTotal Decimal?         @db.Decimal(10, 6)
  brakeClearanceRear  Decimal?         @db.Decimal(10, 6)

  // Flywheel
  flywheelStoppingTime Decimal?              @db.Decimal(10, 6)
  flywheelBearings     FlywheelBearingsType?
  flywheelBrake        FlywheelBrakeType?

  // Rotary Union
  rotaryUnion RotaryUnionType?

  // Clutch details
  clutchEngagements Int?
  clutchLining      ClutchLiningType?
  clutchSeals       ClutchSealsType?

  // Gear and measurements (*Check only if excessive noise and/or vibration is present)
  gearBacklashBefore Decimal? @db.Decimal(10, 6)
  gearBacklashAfter  Decimal? @db.Decimal(10, 6)
  crankEndplayBefore Decimal? @db.Decimal(10, 6)
  crankEndplayAfter  Decimal? @db.Decimal(10, 6)

  // Air system
  airRegulatorValue   Decimal?                 @db.Decimal(10, 6)
  airClutchTravel     Decimal?                 @db.Decimal(10, 6)
  airLineOilerSetting AirLineOilerSettingType?

  // Splines
  splinesDriveRingDisc SplinesConditionType?

  // Adjusting Nut/Lock
  adjustingNutLockSecure AdjustingNutLockType?

  // Hydraulic system
  hydClutchClearanceTotal Decimal? @db.Decimal(10, 6)
  hydClutchClearanceRear  Decimal? @db.Decimal(10, 6)
  hydraulicPressureValue  Decimal? @db.Decimal(10, 6)
  accumulatorValue        String?

  // Pneumatic system (for CLUTCH_CEVOLANI section)
  pneumaticClutchClearanceTotal Decimal? @db.Decimal(10, 6)

  // Separate Brake Seals
  separateBrakeSeals SeparateBrakeSealsType?

  // Flex Disc
  flexDisc FlexDiscType?

  // Notes
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services         MachineServiceClutch[]
  cevolaniServices MachineServiceClutchCevolani[] @relation("ClutchCevolaniData")

  @@map("service_data_clutch")
}

