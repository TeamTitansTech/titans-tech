// Notification and Email Models

enum NotificationType {
  URGENT_SERVICE_REQUEST
  SERVICE_REMINDER
  SERVICE_OVERDUE
  SERVICE_COMPLETED
  INSPECTION_ALERT
  PARTS_REQUEST
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

enum EmailProvider {
  SENDGRID
  AWS_SES
}

model Notification {
  id String @id @default(cuid())

  type            NotificationType @default(URGENT_SERVICE_REQUEST)
  createdByUserId String?
  metadata        Json? // Store additional data like notes, urgency level, etc.
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  createdBy  User?                   @relation("NotificationsCreated", fields: [createdByUserId], references: [id], onDelete: Cascade)
  recipients NotificationRecipient[]

  @@index([createdAt])
  @@map("admin_notifications")
}

model NotificationRecipient {
  notificationId String
  /**
   * Id from sys admin or a regular user
   */
  recipientId    String
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@id([notificationId, recipientId])
  @@index([recipientId, isRead])
  @@map("admin_notification_recipients")
}

model Email {
  id         String           @id @default(cuid())
  to         String
  from       String
  subject    String
  body       String           @db.Text
  type       NotificationType
  status     EmailStatus      @default(PENDING)
  provider   EmailProvider
  externalId String? // Provider's message ID (SendGrid/SES tracking)
  error      String?          @db.Text
  sentAt     DateTime?
  machineId  String?
  metadata   Json? // Store additional email data (CC, BCC, attachments info, etc.)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  machine Machine? @relation(fields: [machineId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@map("emails")
}

