model SysAdmin {
  id                     String   @id @default(cuid())
  email                  String   @unique
  password               String
  isUsingDefaultPassword Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("sys_admins")
}

model Company {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  logo        String?
  loginLogo   String?
  brandColor  String?
  accentColor String?
  description String?

  // Contract limits - set by SysAdmin only
  contractMaxBranches        Int @default(5)
  contractMaxUsers           Int @default(25)
  contractMaxMachines        Int @default(50)
  contractMaxProductionLines Int @default(20)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  branches            CompanyBranch[]
  users               User[]
  permissionTemplates PermissionTemplate[]

  @@map("companies")
}

model PermissionTemplate {
  id          String  @id @default(cuid())
  name        String
  description String?
  permissions Json // Stores the Permissions object as JSON

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  @@map("permission_templates")
}

model CompanyBranch {
  id           String  @id @default(cuid())
  name         String
  isMainBranch Boolean @default(false)
  location     String?

  defaultMeasurementUnit MeasurementUnit @default(INCHES)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company         Company          @relation(fields: [companyId], references: [id])
  companyId       String
  users           UserBranch[]
  machines        Machine[]
  productionLines ProductionLine[]

  @@map("company_branches")
}

model User {
  id                     String  @id @default(cuid())
  name                   String?
  email                  String
  password               String
  isCompanyAdmin         Boolean @default(false)
  isUsingDefaultPassword Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company              Company        @relation(fields: [companyId], references: [id])
  companyId            String
  branches             UserBranch[]
  notificationsCreated Notification[] @relation("NotificationsCreated")

  @@unique([companyId, email])
  @@map("users")
}

model UserBranch {
  user      User          @relation(fields: [userId], references: [id])
  userId    String
  branch    CompanyBranch @relation(fields: [branchId], references: [id])
  branchId  String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?

  // User Management Permissions
  readUsers             Boolean @default(false)
  createUsers           Boolean @default(false)
  updateUsers           Boolean @default(false)
  deleteUsers           Boolean @default(false)
  manageUserPermissions Boolean @default(false)
  assignUsersToBranches Boolean @default(false)

  // Branch Management Permissions
  readBranches   Boolean @default(false)
  updateBranches Boolean @default(false)

  // Machine Permissions
  readMachines   Boolean @default(false)
  createMachines Boolean @default(false)
  updateMachines Boolean @default(false)
  deleteMachines Boolean @default(false)

  // Service Permissions
  readServices   Boolean @default(false)
  createServices Boolean @default(false)
  updateServices Boolean @default(false)
  deleteServices Boolean @default(false)

  // Production Line Permissions
  readProductionLines   Boolean @default(false)
  createProductionLines Boolean @default(false)
  updateProductionLines Boolean @default(false)
  deleteProductionLines Boolean @default(false)

  @@id([userId, branchId])
  @@map("user_branches")
}

// Machine Management Models

model Blueprint {
  id        String           @id @default(cuid())
  name      String
  imageUrl  String?
  fields    Json // Array of { fieldName, fieldSlug, fieldType, fieldOptions? }
  sections  ServiceSection[] // Array of service sections
  deletedAt DateTime? // Soft delete to preserve historical data
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  machines                              Machine[]
  thresholdBearingClearance             ThresholdBearingClearance?
  thresholdBearingClearanceSingleHammer ThresholdBearingClearanceSingleHammer?
  thresholdClutch                       ThresholdClutch?
  thresholdClutchCevolani               ThresholdClutchCevolani?
  thresholdSlideSingleHammer            ThresholdSlideSingleHammer?
  thresholdSlideDoubleHammer            ThresholdSlideDoubleHammer?
  thresholdGibs                         ThresholdGibs?
  thresholdPistons                      ThresholdPistons?
  thresholdTramming                     ThresholdTramming?

  @@map("blueprints")
}

model ThresholdBearingClearance {
  id          String @id @default(cuid())
  blueprintId String @unique

  // Total Clearance thresholds
  totalClearance_greenMin  Decimal @db.Decimal(10, 6)
  totalClearance_yellowMin Decimal @db.Decimal(10, 6)
  totalClearance_redMin    Decimal @db.Decimal(10, 6)

  // Main Bearings thresholds
  mainBearings_greenMin  Decimal @db.Decimal(10, 6)
  mainBearings_yellowMin Decimal @db.Decimal(10, 6)
  mainBearings_redMin    Decimal @db.Decimal(10, 6)

  // Upper Connection Bearings thresholds
  upperConnectionBearings_greenMin  Decimal @db.Decimal(10, 6)
  upperConnectionBearings_yellowMin Decimal @db.Decimal(10, 6)
  upperConnectionBearings_redMin    Decimal @db.Decimal(10, 6)

  // Wrist Pin to Mating Part thresholds
  wristPinToMatingPart_greenMin  Decimal @db.Decimal(10, 6)
  wristPinToMatingPart_yellowMin Decimal @db.Decimal(10, 6)
  wristPinToMatingPart_redMin    Decimal @db.Decimal(10, 6)

  // Wrist Pin to Bushing thresholds
  wristPinToBushing_greenMin  Decimal @db.Decimal(10, 6)
  wristPinToBushing_yellowMin Decimal @db.Decimal(10, 6)
  wristPinToBushing_redMin    Decimal @db.Decimal(10, 6)

  // Slide Adj Nut to Screw/Sleeve thresholds
  slideAdjNutToScrewSleeve_greenMin  Decimal @db.Decimal(10, 6)
  slideAdjNutToScrewSleeve_yellowMin Decimal @db.Decimal(10, 6)
  slideAdjNutToScrewSleeve_redMin    Decimal @db.Decimal(10, 6)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blueprint Blueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)

  @@map("threshold_bearing_clearance")
}

model ThresholdBearingClearanceSingleHammer {
  id          String @id @default(cuid())
  blueprintId String @unique

  // Total Clearance thresholds
  totalClearance_greenMin  Decimal @db.Decimal(10, 6)
  totalClearance_yellowMin Decimal @db.Decimal(10, 6)
  totalClearance_redMin    Decimal @db.Decimal(10, 6)

  // Main Bearings thresholds
  mainBearings_greenMin  Decimal @db.Decimal(10, 6)
  mainBearings_yellowMin Decimal @db.Decimal(10, 6)
  mainBearings_redMin    Decimal @db.Decimal(10, 6)

  // Upper Connection Bearings thresholds
  upperConnectionBearings_greenMin  Decimal @db.Decimal(10, 6)
  upperConnectionBearings_yellowMin Decimal @db.Decimal(10, 6)
  upperConnectionBearings_redMin    Decimal @db.Decimal(10, 6)

  // Wrist Pin to Mating Part thresholds
  wristPinToMatingPart_greenMin  Decimal @db.Decimal(10, 6)
  wristPinToMatingPart_yellowMin Decimal @db.Decimal(10, 6)
  wristPinToMatingPart_redMin    Decimal @db.Decimal(10, 6)

  // Wrist Pin to Bushing thresholds
  wristPinToBushing_greenMin  Decimal @db.Decimal(10, 6)
  wristPinToBushing_yellowMin Decimal @db.Decimal(10, 6)
  wristPinToBushing_redMin    Decimal @db.Decimal(10, 6)

  // Slide Adj Nut to Screw/Sleeve thresholds
  slideAdjNutToScrewSleeve_greenMin  Decimal @db.Decimal(10, 6)
  slideAdjNutToScrewSleeve_yellowMin Decimal @db.Decimal(10, 6)
  slideAdjNutToScrewSleeve_redMin    Decimal @db.Decimal(10, 6)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blueprint Blueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)

  @@map("threshold_bearing_clearance_single_hammer")
}

model ThresholdClutch {
  id          String @id @default(cuid())
  blueprintId String @unique

  // Hyd Clutch Clearance Total thresholds
  hydClutchClearanceTotal_greenMin  Decimal @db.Decimal(10, 6)
  hydClutchClearanceTotal_yellowMin Decimal @db.Decimal(10, 6)
  hydClutchClearanceTotal_redMin    Decimal @db.Decimal(10, 6)

  // Hyd Clutch Clearance Rear thresholds
  hydClutchClearanceRear_greenMin  Decimal @db.Decimal(10, 6)
  hydClutchClearanceRear_yellowMin Decimal @db.Decimal(10, 6)
  hydClutchClearanceRear_redMin    Decimal @db.Decimal(10, 6)

  // F-B (Front-Back) thresholds
  fb_greenMin  Decimal @db.Decimal(10, 6)
  fb_yellowMin Decimal @db.Decimal(10, 6)
  fb_redMin    Decimal @db.Decimal(10, 6)

  // F-TB (Front Top-Bottom) thresholds
  fTB_greenMin  Decimal @db.Decimal(10, 6)
  fTB_yellowMin Decimal @db.Decimal(10, 6)
  fTB_redMin    Decimal @db.Decimal(10, 6)

  // R-TB (Rear Top-Bottom) thresholds
  rTB_greenMin  Decimal @db.Decimal(10, 6)
  rTB_yellowMin Decimal @db.Decimal(10, 6)
  rTB_redMin    Decimal @db.Decimal(10, 6)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blueprint Blueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)

  @@map("threshold_clutch")
}

model ThresholdClutchCevolani {
  id          String @id @default(cuid())
  blueprintId String @unique

  // Pneumatic Clutch Clearance Total thresholds
  pneumaticClutchClearanceTotal_greenMin  Decimal @db.Decimal(10, 6)
  pneumaticClutchClearanceTotal_yellowMin Decimal @db.Decimal(10, 6)
  pneumaticClutchClearanceTotal_redMin    Decimal @db.Decimal(10, 6)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blueprint Blueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)

  @@map("threshold_clutch_cevolani")
}

model ThresholdSlideSingleHammer {
  id          String @id @default(cuid())
  blueprintId String @unique

  // Max Deviation thresholds (single threshold for both outer and inner)
  maxDeviation_greenMin  Decimal @db.Decimal(10, 6)
  maxDeviation_yellowMin Decimal @db.Decimal(10, 6)
  maxDeviation_redMin    Decimal @db.Decimal(10, 6)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blueprint Blueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)

  @@map("threshold_slide_single_hammer")
}

model ThresholdSlideDoubleHammer {
  id          String @id @default(cuid())
  blueprintId String @unique

  // Max Deviation thresholds (single threshold for both outer and inner)
  maxDeviation_greenMin  Decimal @db.Decimal(10, 6)
  maxDeviation_yellowMin Decimal @db.Decimal(10, 6)
  maxDeviation_redMin    Decimal @db.Decimal(10, 6)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blueprint Blueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)

  @@map("threshold_slide_double_hammer")
}

model ThresholdGibs {
  id          String @id @default(cuid())
  blueprintId String @unique

  // Usable thresholds (single field with green/yellow/red levels)
  usable_greenMin  Decimal @db.Decimal(10, 6)
  usable_yellowMin Decimal @db.Decimal(10, 6)
  usable_redMin    Decimal @db.Decimal(10, 6)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blueprint Blueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)

  @@map("threshold_gibs")
}

model ThresholdPistons {
  id          String @id @default(cuid())
  blueprintId String @unique

  // Threshold mode: LINEAR (traditional) or CENTRAL (U-shaped/target-based)
  thresholdMode ThresholdMode @default(LINEAR)

  // LINEAR mode: Difference thresholds (for side-to-side differences)
  // Values below yellowMin are green, below redMin are yellow, at/above redMin are red
  difference_greenMin  Decimal @db.Decimal(10, 4)
  difference_yellowMin Decimal @db.Decimal(10, 4)
  difference_redMin    Decimal @db.Decimal(10, 4)

  // CENTRAL mode: U-shaped thresholds with explicit boundaries
  // Example: yellowMin=0.002, greenMin=0.004, greenMax=0.008, yellowMax=0.010
  // Red low:    0 to yellowMin (0.000 - 0.002)
  // Yellow low: yellowMin to greenMin (0.002 - 0.004)
  // Green:      greenMin to greenMax (0.004 - 0.008)
  // Yellow high: greenMax to yellowMax (0.008 - 0.010)
  // Red high:   above yellowMax (0.010+)
  central_yellowMin Decimal? @db.Decimal(10, 4)
  central_greenMin  Decimal? @db.Decimal(10, 4)
  central_greenMax  Decimal? @db.Decimal(10, 4)
  central_yellowMax Decimal? @db.Decimal(10, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blueprint Blueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)

  @@map("threshold_pistons")
}

model ThresholdTramming {
  id          String @id @default(cuid())
  blueprintId String @unique

  // Single threshold range for all tramming sums (vertical and horizontal)
  greenMin  Decimal @db.Decimal(10, 6)
  yellowMin Decimal @db.Decimal(10, 6)
  redMin    Decimal @db.Decimal(10, 6)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blueprint Blueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)

  @@map("threshold_tramming")
}

model Machine {
  id          String  @id @default(cuid())
  blueprintId String
  branchId    String
  name        String // Machine name/identifier
  imageUrl    String? // URL to machine image (S3 or external)

  // Machine specifications
  manufacturer    String?
  sizeTonnage     String?
  serialNumber    String
  stroke          String?
  foundationType  FoundationType?
  frameType       FrameType?
  clutchType      MachineClutchType?
  pneumaticSystem PneumaticSystemType?
  pressMounting   PressMountingType?
  features        MachineFeaturesType?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  blueprint       Blueprint               @relation(fields: [blueprintId], references: [id], onDelete: Restrict)
  branch          CompanyBranch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  fields          MachineField[]
  services        MachineService[]
  serviceRequests ServiceRequest[]
  emails          Email[]
  productionLines MachineProductionLine[]
  partsConfig     MachinePartsConfig?

  @@map("machines")
}

model MachineField {
  id        String    @id @default(cuid())
  machineId String
  fieldSlug String
  value     String // Store as string, convert based on fieldType from blueprint
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@unique([machineId, fieldSlug])
  @@map("machine_fields")
}

// Machine Service Models

model MachineService {
  id                 String        @id @default(cuid())
  machineId          String
  serviceRequestId   String? // Optional: if created from a service request
  date               DateTime
  type               ServiceType   @default(INSPECTION)
  status             ServiceStatus @default(PENDING)
  performedBy        String? // Optional: userId of who performed the service
  notes              String?       @db.Text // Additional notes/comments for the service
  completedSections  Json?         @default("[]") // Array of completed section keys
  lastSectionSavedAt DateTime? // Timestamp of last section save
  currentStep        String? // Current step in the modal: 'selection', 'details', 'sections', 'summary'
  currentSectionKey  String? // Current section being filled (e.g., 'BEARING_CLEARANCE')
  selectedSections   Json?         @default("[]") // Array of selected section keys
  attachments        Json?         @default("[]") // Array of attached documents [{name: string, url: string}]

  // Inspection observation fields
  isPressLevel                YesNoNaDncType?
  driveBeltCondition          DriveBeltConditionType?
  areAllProtectiveCovers      ProtectiveCoversStatusType?
  protectiveCoversExplanation String?
  areCracksVisible            YesNoDncType?
  cracksLocation              String?
  isMainMotorSecure           YesNoDncType?
  isMotorPlateSecure          YesNoDncType?
  whyNotCovered               String?
  fillAngularity              Boolean?                    @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  machine                           Machine                                      @relation(fields: [machineId], references: [id], onDelete: Cascade)
  serviceRequest                    ServiceRequest?                              @relation(fields: [serviceRequestId], references: [id], onDelete: SetNull)
  bearingClearance                  MachineServiceBearingClearance[]
  bearingClearanceSingleHammer      MachineServiceBearingClearanceSingleHammer[]
  slide                             MachineServiceSlide[] // DEPRECATED: Use slideSingleHammer and slideDoubleHammer
  slideSingleHammer                 MachineServiceSlideSingleHammer[]
  slideDoubleHammer                 MachineServiceSlideDoubleHammer[]
  gibs                              MachineServiceGibs[]
  lubricationHydraulics             MachineServiceLubricationHydraulics[]
  clutch                            MachineServiceClutch[]
  clutchCevolani                    MachineServiceClutchCevolani[]
  counterbalanceCylinderAirbag      MachineServiceCounterbalanceCylinderAirbag[]
  tramming                          MachineServiceTramming[]
  pistons                           MachineServicePistons[]
  alertBearingClearance             AlertBearingClearance[]
  alertBearingClearanceSingleHammer AlertBearingClearanceSingleHammer[]
  alertCounterbalanceCylinderAirbag AlertCounterbalanceCylinderAirbag[]
  alertClutch                       AlertClutch[]
  alertClutchCevolani               AlertClutchCevolani[]
  alertSlide                        AlertSlide[] // DEPRECATED: Use alertSlideSingleHammer and alertSlideDoubleHammer
  alertSlideSingleHammer            AlertSlideSingleHammer[]
  alertSlideDoubleHammer            AlertSlideDoubleHammer[]
  alertGibs                         AlertGibs[]
  alertPistons                      AlertPistons[]
  alertTramming                     AlertTramming[]
  shimThickness                     MachineServiceShimThickness[]
  dieCushion                        MachineServiceDieCushion[]
  electricalControl                 MachineServiceElectricalControl[]
  perpendicularity                  MachineServicePerpendicularity[]
  angularity                        MachineServiceAngularity[]

  @@index([serviceRequestId])
  @@map("machine_services")
}

model AlertBearingClearance {
  id               String @id @default(cuid())
