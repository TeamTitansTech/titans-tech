// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MatingPartType {
  BUSHING
  CONNECTION
  NUT_SCREW_SLEEVE
}

enum ParallelismType {
  DNC
  TO_BED
  TO_BOLSTER
}

enum MeasurementUnit {
  INCHES
  MM
}

enum InspectionSection {
  BEARING_CLEARANCE
  SLIDE
  GIBS
  LUBRICATION_HYDRAULICS_PRESSURE_SWITCHES_OIL_FILTER
  CLUTCH
  COUNTERBALANCE_CYLINDER_AIRBAG
}

model SysAdmin {
  id                     String   @id @default(cuid())
  email                  String   @unique
  password               String
  isUsingDefaultPassword Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("sys_admins")
}

model Company {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logo        String?
  brandColor  String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branches CompanyBranch[]
  users    User[]

  @@map("companies")
}

model CompanyBranch {
  id           String  @id @default(cuid())
  name         String
  isMainBranch Boolean @default(false)
  location     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company      @relation(fields: [companyId], references: [id])
  companyId String
  users     UserBranch[]
  machines  Machine[]

  @@map("company_branches")
}

model User {
  id                     String  @id @default(cuid())
  name                   String?
  email                  String  @unique
  password               String
  isCompanyAdmin         Boolean @default(false)
  isCompanyManager       Boolean @default(false)
  isUsingDefaultPassword Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company      @relation(fields: [companyId], references: [id])
  companyId String
  branches  UserBranch[]

  @@map("users")
}

model UserBranch {
  user      User          @relation(fields: [userId], references: [id])
  userId    String
  branch    CompanyBranch @relation(fields: [branchId], references: [id])
  branchId  String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // User Management Permissions
  readUsers             Boolean @default(false)
  createUsers           Boolean @default(false)
  updateUsers           Boolean @default(false)
  deleteUsers           Boolean @default(false)
  manageUserPermissions Boolean @default(false)
  assignUsersToBranches Boolean @default(false)

  // Branch Management Permissions
  readBranches   Boolean @default(false)
  updateBranches Boolean @default(false)

  // Blueprint Permissions
  readBlueprints   Boolean @default(false)
  createBlueprints Boolean @default(false)
  updateBlueprints Boolean @default(false)
  deleteBlueprints Boolean @default(false)

  // Machine Permissions
  readMachines   Boolean @default(false)
  createMachines Boolean @default(false)
  updateMachines Boolean @default(false)
  deleteMachines Boolean @default(false)

  // Inspection Permissions
  readInspections   Boolean @default(false)
  createInspections Boolean @default(false)
  updateInspections Boolean @default(false)
  deleteInspections Boolean @default(false)

  @@id([userId, branchId])
  @@map("user_branches")
}

// Machine Management Models

model Blueprint {
  id        String              @id @default(cuid())
  name      String
  fields    Json // Array of { fieldName, fieldSlug, fieldType, fieldOptions? }
  sections  InspectionSection[] // Array of inspection sections
  deletedAt DateTime? // Soft delete to preserve historical data
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  machines Machine[]

  @@map("blueprints")
}

model Machine {
  id          String   @id @default(cuid())
  blueprintId String
  branchId    String
  name        String // Machine name/identifier
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  blueprint   Blueprint           @relation(fields: [blueprintId], references: [id], onDelete: Restrict)
  branch      CompanyBranch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  fields      MachineField[]
  inspections MachineInspection[]

  @@map("machines")
}

model MachineField {
  id        String   @id @default(cuid())
  machineId String
  fieldSlug String
  value     String // Store as string, convert based on fieldType from blueprint
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@unique([machineId, fieldSlug])
  @@map("machine_fields")
}

model MachineInspection {
  id            String   @id @default(cuid())
  machineId     String
  date          DateTime
  isMaintenance Boolean  @default(false)
  performedBy   String? // Optional: userId of who performed the inspection
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  machine                Machine                             @relation(fields: [machineId], references: [id], onDelete: Cascade)
  bearingClearanceChecks MachineInspectionBearingClearance[]
  slideChecks            MachineInspectionSlide[]

  @@map("machine_inspections")
}

model MachineInspectionBearingClearance {
  id                  String  @id @default(cuid())
  machineInspectionId String
  beforeId            String?
  afterId             String?

  machineInspection MachineInspection @relation(fields: [machineInspectionId], references: [id], onDelete: Cascade)
  before            BearingClearance? @relation("BeforeMeasurement", fields: [beforeId], references: [id], onDelete: SetNull)
  after             BearingClearance? @relation("AfterMeasurement", fields: [afterId], references: [id], onDelete: SetNull)

  @@map("machine_inspection_bearing_clearance")
}

model BearingClearance {
  id String @id @default(cuid())

  // Outer measurements - all Decimal with 4 precision (all required)
  totalClearance_RH                Decimal @db.Decimal(10, 4)
  totalClearance_LH                Decimal @db.Decimal(10, 4)
  mainBearings_RH                  Decimal @db.Decimal(10, 4)
  mainBearings_LH                  Decimal @db.Decimal(10, 4)
  upperConnectionBearings_RH       Decimal @db.Decimal(10, 4)
  upperConnectionBearings_LH       Decimal @db.Decimal(10, 4)
  wristPinToMatingPart_RH          Decimal @db.Decimal(10, 4)
  wristPinToMatingPart_LH          Decimal @db.Decimal(10, 4)
  wristPinToBushing_RH             Decimal @db.Decimal(10, 4)
  wristPinToBushing_LH             Decimal @db.Decimal(10, 4)
  slide_adj_nut_to_screw_sleeve_RH Decimal @db.Decimal(10, 4)
  slide_adj_nut_to_screw_sleeve_LH Decimal @db.Decimal(10, 4)
  extra_double_lockOpen_RH         Decimal @db.Decimal(10, 4)
  extra_double_lockOpen_LH         Decimal @db.Decimal(10, 4)
  ball_box_area_RH                 Decimal @db.Decimal(10, 4)
  ball_box_area_LH                 Decimal @db.Decimal(10, 4)

  // Inner measurements (all required)
  innerTotalClearance_RH                Decimal @db.Decimal(10, 4)
  innerTotalClearance_LH                Decimal @db.Decimal(10, 4)
  innerMainBearings_RH                  Decimal @db.Decimal(10, 4)
  innerMainBearings_LH                  Decimal @db.Decimal(10, 4)
  innerUpperConnectionBearings_RH       Decimal @db.Decimal(10, 4)
  innerUpperConnectionBearings_LH       Decimal @db.Decimal(10, 4)
  innerWristPinToMatingPart_RH          Decimal @db.Decimal(10, 4)
  innerWristPinToMatingPart_LH          Decimal @db.Decimal(10, 4)
  innerWristPinToBushing_RH             Decimal @db.Decimal(10, 4)
  innerWristPinToBushing_LH             Decimal @db.Decimal(10, 4)
  innerSlide_adj_nut_to_screw_sleeve_RH Decimal @db.Decimal(10, 4)
  innerSlide_adj_nut_to_screw_sleeve_LH Decimal @db.Decimal(10, 4)
  innerExtra_double_lockOpen_RH         Decimal @db.Decimal(10, 4)
  innerExtra_double_lockOpen_LH         Decimal @db.Decimal(10, 4)
  innerBall_box_area_RH                 Decimal @db.Decimal(10, 4)
  innerBall_box_area_LH                 Decimal @db.Decimal(10, 4)

  // Additional fields (required)
  combined_with String
  mating_part   MatingPartType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  beforeInspections MachineInspectionBearingClearance[] @relation("BeforeMeasurement")
  afterInspections  MachineInspectionBearingClearance[] @relation("AfterMeasurement")

  @@map("bearing_clearances")
}

// Slide Inspection Models

model MachineInspectionSlide {
  id                  String  @id @default(cuid())
  machineInspectionId String
  outerSlideBeforeId  String?
  outerSlideAfterId   String?
  innerSlideBeforeId  String?
  innerSlideAfterId   String?

  machineInspection MachineInspection @relation(fields: [machineInspectionId], references: [id], onDelete: Cascade)
  outerSlideBefore  SlideData?        @relation("OuterSlideBefore", fields: [outerSlideBeforeId], references: [id], onDelete: SetNull)
  outerSlideAfter   SlideData?        @relation("OuterSlideAfter", fields: [outerSlideAfterId], references: [id], onDelete: SetNull)
  innerSlideBefore  SlideData?        @relation("InnerSlideBefore", fields: [innerSlideBeforeId], references: [id], onDelete: SetNull)
  innerSlideAfter   SlideData?        @relation("InnerSlideAfter", fields: [innerSlideAfterId], references: [id], onDelete: SetNull)

  @@map("machine_inspection_slide")
}

model SlideData {
  id String @id @default(cuid())

  // Parallelism measurements (3 positions)
  parallelism        ParallelismType
  hasBeenAdjusted    Boolean         @default(false)
  position1          Decimal         @db.Decimal(10, 4)
  position2          Decimal         @db.Decimal(10, 4)
  position3          Decimal         @db.Decimal(10, 4)
  unit               MeasurementUnit
  shutheightChecked  Boolean         @default(false)
  actualSH           String?
  overloadsOnMonitor String?
  indicatorReading   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outerSlideBeforeInspections MachineInspectionSlide[] @relation("OuterSlideBefore")
  outerSlideAfterInspections  MachineInspectionSlide[] @relation("OuterSlideAfter")
  innerSlideBeforeInspections MachineInspectionSlide[] @relation("InnerSlideBefore")
  innerSlideAfterInspections  MachineInspectionSlide[] @relation("InnerSlideAfter")

  @@map("slide_data")
}
