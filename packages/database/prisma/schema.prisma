// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ServiceType {
  INSPECTION
  MAINTENANCE
}

enum ServiceStatus {
  PENDING
  COMPLETED
}

enum MatingPartType {
  BUSHING
  CONNECTION
  NUT_SCREW_SLEEVE
}

enum ParallelismType {
  DNC
  TO_BED
  TO_BOLSTER
}

enum DncToBedToBolsterType {
  DNC
  TO_BED
  TO_BOLSTER
}

enum YesNoNaDncType {
  YES
  NO
  NA
  DNC
}

enum YesNoDncType {
  YES
  NO
  DNC
}

enum LubeHydMonitorFlowPressSwGibType {
  LUBE
  HYD
  MONITORFLOW
  PRESS_SW
  GIB
}

enum ConditionOkNaDncBrokenWornType {
  OK
  NA
  DNC
  BROKEN
  WORN
}

enum ConditionOkNaDncBrokenLooseType {
  OK
  NA
  DNC
  BROKEN
  LOOSE
}

enum ConditionOkNaDncDamagedType {
  OK
  NA
  DNC
  DAMAGED
}

enum SystemType {
  LUBE
  HYD
  MONITORFLOW
  PRESS_SW
  GIB
}

enum OkNaDncDamageType {
  OK
  NA
  DNC
}

enum MeasurementUnit {
  INCHES
  MM
}

enum CylinderAirbagType {
  CYLINDER
  AIRBAG
}

enum OkNaDncLeakingType {
  OK
  NA
  DNC
  LEAKING
}

enum OkNaDncNotOperationalType {
  OK
  NA
  DNC
  NOT_OPERATIONAL
}

enum OkNaDncNotOperationalLeakingType {
  OK
  NA
  DNC
  NOT_OPERATIONAL
  LEAKING
}

enum OkNaDncDarkOilType {
  OK
  NA
  DNC
  DARK_OIL
}

enum OkNaDncNeedReplacedType {
  OK
  NA
  DNC
  NEEDS_REPLACED
}

enum ClutchType {
  AFC
  CFC
  EFHC
  GC
  HC
  MC
  MDHC
  MHC
  MHCC
}

enum ClutchLocation {
  CRANKSHAFT
  DRIVESHAFT
}

enum BrakeSpringStudBoltType {
  OK
  NA
  DNC
  BROKEN
  BENT_WORN
}

enum BrakeLiningType {
  OK
  NA
  DNC
  GLAZED
  OIL_SOAKED
  MISSING_SEGMENTS
}

enum FlywheelBearingsType {
  OK
  NA
  DNC
  NOISE
  WOBBLE
}

enum FlywheelBrakeType {
  OK
  NA
  DNC
  LINING_WORN
}

enum RotaryUnionType {
  OK
  NA
  DNC
  AIR_LEAK
  OIL_LEAK
  CONCENTRICITY
}

enum ClutchLiningType {
  OK
  NA
  DNC
  GLAZED
  OIL_SOAKED
  MISSING_SEGMENTS
}

enum ClutchSealsType {
  OK
  NA
  DNC
  LEAKING
  SLOW_RESPONSE
}

enum PressureUnit {
  BAR
  MPA
  PSI
}

enum SplinesConditionType {
  OK
  NA
  DNC
  BROKEN
  NOT_VISIBLE
  WEAR_VISIBLE
}

enum AdjustingNutLockType {
  OK
  NA
  DNC
}

enum AirLineOilerSettingType {
  OK
  NA
  DNC
  NEEDS_OIL
  NEEDS_OIL_RESET
  NEEDS_RESET
}

enum SeparateBrakeSealsType {
  OK
  NA
  DNC
  LEAKING
}

enum FlexDiscType {
  OK
  NA
  DNC
  BUCKLED
  CRACKED
}

enum ServiceSection {
  BEARING_CLEARANCE
  SLIDE
  GIBS
  LUBRICATION_HYDRAULICS_PRESSURE_SWITCHES_OIL_FILTER
  CLUTCH
  COUNTERBALANCE_CYLINDER_AIRBAG
  TRAMMING
}

enum AlertSeverity {
  GREEN
  YELLOW
  RED
  NONE
}

model SysAdmin {
  id                     String   @id @default(cuid())
  email                  String   @unique
  password               String
  isUsingDefaultPassword Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("sys_admins")
}

model Company {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logo        String?
  brandColor  String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branches CompanyBranch[]
  users    User[]

  @@map("companies")
}

model CompanyBranch {
  id           String  @id @default(cuid())
  name         String
  isMainBranch Boolean @default(false)
  location     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company      @relation(fields: [companyId], references: [id])
  companyId String
  users     UserBranch[]
  machines  Machine[]

  @@map("company_branches")
}

model User {
  id                     String  @id @default(cuid())
  name                   String?
  email                  String  @unique
  password               String
  isCompanyAdmin         Boolean @default(false)
  isCompanyManager       Boolean @default(false)
  isUsingDefaultPassword Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company      @relation(fields: [companyId], references: [id])
  companyId String
  branches  UserBranch[]

  @@map("users")
}

model UserBranch {
  user      User          @relation(fields: [userId], references: [id])
  userId    String
  branch    CompanyBranch @relation(fields: [branchId], references: [id])
  branchId  String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // User Management Permissions
  readUsers             Boolean @default(false)
  createUsers           Boolean @default(false)
  updateUsers           Boolean @default(false)
  deleteUsers           Boolean @default(false)
  manageUserPermissions Boolean @default(false)
  assignUsersToBranches Boolean @default(false)

  // Branch Management Permissions
  readBranches   Boolean @default(false)
  updateBranches Boolean @default(false)

  // Blueprint Permissions
  readBlueprints   Boolean @default(false)
  createBlueprints Boolean @default(false)
  updateBlueprints Boolean @default(false)
  deleteBlueprints Boolean @default(false)

  // Machine Permissions
  readMachines   Boolean @default(false)
  createMachines Boolean @default(false)
  updateMachines Boolean @default(false)
  deleteMachines Boolean @default(false)

  // Service Permissions
  readServices   Boolean @default(false)
  createServices Boolean @default(false)
  updateServices Boolean @default(false)
  deleteServices Boolean @default(false)

  @@id([userId, branchId])
  @@map("user_branches")
}

// Machine Management Models

model Blueprint {
  id        String           @id @default(cuid())
  name      String
  fields    Json // Array of { fieldName, fieldSlug, fieldType, fieldOptions? }
  sections  ServiceSection[] // Array of service sections
  deletedAt DateTime? // Soft delete to preserve historical data
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  machines                  Machine[]
  thresholdBearingClearance ThresholdBearingClearance?

  @@map("blueprints")
}

model ThresholdBearingClearance {
  id          String @id @default(cuid())
  blueprintId String @unique

  // Total Clearance thresholds
  totalClearance_greenMin  Decimal @db.Decimal(10, 4)
  totalClearance_yellowMin Decimal @db.Decimal(10, 4)
  totalClearance_redMin    Decimal @db.Decimal(10, 4)

  // Main Bearings thresholds
  mainBearings_greenMin  Decimal @db.Decimal(10, 4)
  mainBearings_yellowMin Decimal @db.Decimal(10, 4)
  mainBearings_redMin    Decimal @db.Decimal(10, 4)

  // Upper Connection Bearings thresholds
  upperConnectionBearings_greenMin  Decimal @db.Decimal(10, 4)
  upperConnectionBearings_yellowMin Decimal @db.Decimal(10, 4)
  upperConnectionBearings_redMin    Decimal @db.Decimal(10, 4)

  // Wrist Pin to Mating Part thresholds
  wristPinToMatingPart_greenMin  Decimal @db.Decimal(10, 4)
  wristPinToMatingPart_yellowMin Decimal @db.Decimal(10, 4)
  wristPinToMatingPart_redMin    Decimal @db.Decimal(10, 4)

  // Wrist Pin to Bushing thresholds
  wristPinToBushing_greenMin  Decimal @db.Decimal(10, 4)
  wristPinToBushing_yellowMin Decimal @db.Decimal(10, 4)
  wristPinToBushing_redMin    Decimal @db.Decimal(10, 4)

  // Slide Adj Nut to Screw/Sleeve thresholds
  slideAdjNutToScrewSleeve_greenMin  Decimal @db.Decimal(10, 4)
  slideAdjNutToScrewSleeve_yellowMin Decimal @db.Decimal(10, 4)
  slideAdjNutToScrewSleeve_redMin    Decimal @db.Decimal(10, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blueprint Blueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)

  @@map("threshold_bearing_clearance")
}

model Machine {
  id          String   @id @default(cuid())
  blueprintId String
  branchId    String
  name        String // Machine name/identifier
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  blueprint Blueprint        @relation(fields: [blueprintId], references: [id], onDelete: Restrict)
  branch    CompanyBranch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  fields    MachineField[]
  services  MachineService[]

  @@map("machines")
}

model MachineField {
  id        String   @id @default(cuid())
  machineId String
  fieldSlug String
  value     String // Store as string, convert based on fieldType from blueprint
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@unique([machineId, fieldSlug])
  @@map("machine_fields")
}

// Machine Service Models

model MachineService {
  id                 String        @id @default(cuid())
  machineId          String
  date               DateTime
  type               ServiceType   @default(INSPECTION)
  status             ServiceStatus @default(PENDING)
  performedBy        String? // Optional: userId of who performed the service
  completedSections  Json?         @default("[]") // Array of completed section keys
  lastSectionSavedAt DateTime? // Timestamp of last section save
  currentStep        String? // Current step in the modal: 'selection', 'details', 'sections', 'summary'
  currentSectionKey  String? // Current section being filled (e.g., 'BEARING_CLEARANCE')
  selectedSections   Json?         @default("[]") // Array of selected section keys
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  machine                      Machine                                      @relation(fields: [machineId], references: [id], onDelete: Cascade)
  bearingClearance             MachineServiceBearingClearance[]
  slide                        MachineServiceSlide[]
  gibs                         MachineServiceGibs[]
  lubricationHydraulics        MachineServiceLubricationHydraulics[]
  clutch                       MachineServiceClutch[]
  counterbalanceCylinderAirbag MachineServiceCounterbalanceCylinderAirbag[]
  tramming                     MachineServiceTramming[]
  alertBearingClearance        AlertBearingClearance?

  @@map("machine_services")
}

model AlertBearingClearance {
  id               String @id @default(cuid())
  machineServiceId String @unique

  // Total Clearance alert - only differential and severity
  totalClearance_differential Decimal       @db.Decimal(10, 4)
  totalClearance_severity     AlertSeverity

  // Main Bearings alert - only differential and severity
  mainBearings_differential Decimal       @db.Decimal(10, 4)
  mainBearings_severity     AlertSeverity

  // Upper Connection Bearings alert - only differential and severity
  upperConnectionBearings_differential Decimal       @db.Decimal(10, 4)
  upperConnectionBearings_severity     AlertSeverity

  // Wrist Pin to Mating Part alert - only differential and severity
  wristPinToMatingPart_differential Decimal       @db.Decimal(10, 4)
  wristPinToMatingPart_severity     AlertSeverity

  // Wrist Pin to Bushing alert - only differential and severity
  wristPinToBushing_differential Decimal       @db.Decimal(10, 4)
  wristPinToBushing_severity     AlertSeverity

  // Slide Adj Nut to Screw/Sleeve alert - only differential and severity
  slideAdjNutToScrewSleeve_differential Decimal       @db.Decimal(10, 4)
  slideAdjNutToScrewSleeve_severity     AlertSeverity

  // Optional snapshot of thresholds used in calculation (for auditing)
  thresholdSnapshot Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  machineService MachineService @relation(fields: [machineServiceId], references: [id], onDelete: Cascade)

  @@map("alert_bearing_clearance")
}

// BEARING_CLEARANCE Section

model MachineServiceBearingClearance {
  id               String  @id @default(cuid())
  machineServiceId String
  outerBeforeId    String?
  outerDataId      String?
  innerBeforeId    String?
  innerDataId      String?

  machineService MachineService        @relation(fields: [machineServiceId], references: [id], onDelete: Cascade)
  outerBefore    BearingClearanceData? @relation("OuterBeforeMeasurement", fields: [outerBeforeId], references: [id], onDelete: SetNull)
  outerData      BearingClearanceData? @relation("OuterDataMeasurement", fields: [outerDataId], references: [id], onDelete: SetNull)
  innerBefore    BearingClearanceData? @relation("InnerBeforeMeasurement", fields: [innerBeforeId], references: [id], onDelete: SetNull)
  innerData      BearingClearanceData? @relation("InnerDataMeasurement", fields: [innerDataId], references: [id], onDelete: SetNull)

  @@map("machine_service_bearing_clearance")
}

model BearingClearanceData {
  id String @id @default(cuid())

  // Measurements - all Decimal with 4 precision
  totalClearance_RH           Decimal @db.Decimal(10, 4)
  totalClearance_LH           Decimal @db.Decimal(10, 4)
  mainBearings_RH             Decimal @db.Decimal(10, 4)
  mainBearings_LH             Decimal @db.Decimal(10, 4)
  upperConnectionBearings_RH  Decimal @db.Decimal(10, 4)
  upperConnectionBearings_LH  Decimal @db.Decimal(10, 4)
  wristPinToMatingPart_RH     Decimal @db.Decimal(10, 4)
  wristPinToMatingPart_LH     Decimal @db.Decimal(10, 4)
  wristPinToBushing_RH        Decimal @db.Decimal(10, 4)
  wristPinToBushing_LH        Decimal @db.Decimal(10, 4)
  slideAdjNutToScrewSleeve_RH Decimal @db.Decimal(10, 4)
  slideAdjNutToScrewSleeve_LH Decimal @db.Decimal(10, 4)
  extraDoubleLockOpen_RH      Decimal @db.Decimal(10, 4)
  extraDoubleLockOpen_LH      Decimal @db.Decimal(10, 4)
  ballBoxArea_RH              Decimal @db.Decimal(10, 4)
  ballBoxArea_LH              Decimal @db.Decimal(10, 4)

  // Additional fields
  hasBeenAdjusted YesNoNaDncType?
  combinedWith    String?
  matingPart      MatingPartType?

  // Shutdown Adjustment Mechanism fields
  slideMotorMounts     ConditionOkNaDncBrokenWornType?
  powerCordHoses       ConditionOkNaDncDamagedType?
  chainsGearsSprockets ConditionOkNaDncBrokenLooseType?
  lockingClamps        ConditionOkNaDncDamagedType?
  notes                String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outerBeforeServices MachineServiceBearingClearance[] @relation("OuterBeforeMeasurement")
  outerDataServices   MachineServiceBearingClearance[] @relation("OuterDataMeasurement")
  innerBeforeServices MachineServiceBearingClearance[] @relation("InnerBeforeMeasurement")
  innerDataServices   MachineServiceBearingClearance[] @relation("InnerDataMeasurement")

  @@map("service_data_bearing_clearance")
}

// SLIDE Section

model MachineServiceSlide {
  id               String  @id @default(cuid())
  machineServiceId String
  outerBeforeId    String?
  outerDataId      String?
  innerBeforeId    String?
  innerDataId      String?

  // Outer parallelism fields
  outerParallelism                ParallelismType?
  outerHasParallelismBeenAdjusted YesNoNaDncType?

  // Inner parallelism fields
  innerParallelism                ParallelismType?
  innerHasParallelismBeenAdjusted YesNoNaDncType?

  // Outer shutheight fields
  outerShutheightIndicatorsChecked YesNoDncType?
  outerOverloadsOnTonnageMonitor   String?
  outerShutheightActualSh          String?
  outerIndicatorReading            String?

  // Inner shutheight fields
  innerShutheightIndicatorsChecked YesNoDncType?
  innerOverloadsOnTonnageMonitor   String?
  innerShutheightActualSh          String?
  innerIndicatorReading            String?

  // Notes
  notes String?

  machineService MachineService @relation(fields: [machineServiceId], references: [id], onDelete: Cascade)
  outerBefore    SlideData?     @relation("OuterBeforeMeasurement", fields: [outerBeforeId], references: [id], onDelete: SetNull)
  outerData      SlideData?     @relation("OuterDataMeasurement", fields: [outerDataId], references: [id], onDelete: SetNull)
  innerBefore    SlideData?     @relation("InnerBeforeMeasurement", fields: [innerBeforeId], references: [id], onDelete: SetNull)
  innerData      SlideData?     @relation("InnerDataMeasurement", fields: [innerDataId], references: [id], onDelete: SetNull)

  @@map("machine_service_slide")
}

model SlideData {
  id String @id @default(cuid())

  // Parallelism measurements (6 positions)
  position1 Decimal @db.Decimal(10, 4)
  position2 Decimal @db.Decimal(10, 4)
  position3 Decimal @db.Decimal(10, 4)
  position4 Decimal @db.Decimal(10, 4)
  position5 Decimal @db.Decimal(10, 4)
  position6 Decimal @db.Decimal(10, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outerBeforeServices MachineServiceSlide[] @relation("OuterBeforeMeasurement")
  outerDataServices   MachineServiceSlide[] @relation("OuterDataMeasurement")
  innerBeforeServices MachineServiceSlide[] @relation("InnerBeforeMeasurement")
  innerDataServices   MachineServiceSlide[] @relation("InnerDataMeasurement")

  @@map("service_data_slide")
}

// GIBS Section

model MachineServiceGibs {
  id               String  @id @default(cuid())
  machineServiceId String
  outerBeforeId    String?
  outerDataId      String?
  innerBeforeId    String?
  innerDataId      String?

  machineService MachineService @relation(fields: [machineServiceId], references: [id], onDelete: Cascade)
  outerBefore    GibsData?      @relation("OuterBeforeMeasurement", fields: [outerBeforeId], references: [id], onDelete: SetNull)
  outerData      GibsData?      @relation("OuterDataMeasurement", fields: [outerDataId], references: [id], onDelete: SetNull)
  innerBefore    GibsData?      @relation("InnerBeforeMeasurement", fields: [innerBeforeId], references: [id], onDelete: SetNull)
  innerData      GibsData?      @relation("InnerDataMeasurement", fields: [innerDataId], references: [id], onDelete: SetNull)

  @@map("machine_service_gibs")
}

model GibsData {
  id String @id @default(cuid())

  hasBeenAdjusted YesNoDncType?

  // Front to Back measurements (16 points)
  point1  Decimal @db.Decimal(10, 4)
  point2  Decimal @db.Decimal(10, 4)
  point3  Decimal @db.Decimal(10, 4)
  point4  Decimal @db.Decimal(10, 4)
  point5  Decimal @db.Decimal(10, 4)
  point6  Decimal @db.Decimal(10, 4)
  point7  Decimal @db.Decimal(10, 4)
  point8  Decimal @db.Decimal(10, 4)
  point9  Decimal @db.Decimal(10, 4)
  point10 Decimal @db.Decimal(10, 4)
  point11 Decimal @db.Decimal(10, 4)
  point12 Decimal @db.Decimal(10, 4)
  point13 Decimal @db.Decimal(10, 4)
  point14 Decimal @db.Decimal(10, 4)
  point15 Decimal @db.Decimal(10, 4)
  point16 Decimal @db.Decimal(10, 4)

  // Directional measurements
  leftTop     Decimal? @db.Decimal(10, 4)
  leftBottom  Decimal? @db.Decimal(10, 4)
  rightTop    Decimal? @db.Decimal(10, 4)
  rightBottom Decimal? @db.Decimal(10, 4)
  frontTop    Decimal? @db.Decimal(10, 4)
  frontBottom Decimal? @db.Decimal(10, 4)
  backTop     Decimal? @db.Decimal(10, 4)
  backBottom  Decimal? @db.Decimal(10, 4)

  usable String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outerBeforeServices MachineServiceGibs[] @relation("OuterBeforeMeasurement")
  outerDataServices   MachineServiceGibs[] @relation("OuterDataMeasurement")
  innerBeforeServices MachineServiceGibs[] @relation("InnerBeforeMeasurement")
  innerDataServices   MachineServiceGibs[] @relation("InnerDataMeasurement")

  @@map("service_data_gibs")
}

// LUBRICATION_HYDRAULICS_PRESSURE_SWITCHES_OIL_FILTER Section

model MachineServiceLubricationHydraulics {
  id               String  @id @default(cuid())
  machineServiceId String
  dataId           String?

  machineService MachineService             @relation(fields: [machineServiceId], references: [id], onDelete: Cascade)
  data           LubricationHydraulicsData? @relation(fields: [dataId], references: [id], onDelete: SetNull)

  @@map("machine_service_lubrication_hydraulics")
}

model LubricationHydraulicsData {
  id String @id @default(cuid())

  // Oil information
  changedOil      YesNoDncType @default(DNC)
  oilTemperatureF Int?
  oilMfgType      String?

  // Filter information
  changedFilter YesNoDncType @default(DNC)

  // Notes
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services MachineServiceLubricationHydraulics[]
  gauges   LubricationHydraulicsGauge[]

  @@map("service_data_lubrication_hydraulics")
}

model LubricationHydraulicsGauge {
  id                          String                           @id @default(cuid())
  lubricationHydraulicsDataId String
  system                      LubeHydMonitorFlowPressSwGibType
  gauge                       String?
  psi                         OkNaDncDamageType?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lubricationHydraulicsData LubricationHydraulicsData @relation(fields: [lubricationHydraulicsDataId], references: [id], onDelete: Cascade)

  @@map("lubrication_hydraulics_gauges")
}

// CLUTCH Section

model MachineServiceClutch {
  id               String  @id @default(cuid())
  machineServiceId String
  dataId           String?

  machineService MachineService @relation(fields: [machineServiceId], references: [id], onDelete: Cascade)
  data           ClutchData?    @relation(fields: [dataId], references: [id], onDelete: SetNull)

  @@map("machine_service_clutch")
}

model ClutchData {
  id String @id @default(cuid())

  // Clutch Type and Location
  clutchType     ClutchType?
  clutchLocation ClutchLocation?

  // Brake Spring Settings (in inches)
  brakeSpringBrake    Decimal?                 @db.Decimal(10, 4)
  brakeSpringClutch   Decimal?                 @db.Decimal(10, 4)
  brakeSpringFB       Decimal?                 @db.Decimal(10, 4)
  brakeSpringFTB      Decimal?                 @db.Decimal(10, 4)
  brakeSpringRTB      Decimal?                 @db.Decimal(10, 4)
  brakeSpringStudBolt BrakeSpringStudBoltType?

  // Brake measurements
  brakeStoppingTime   Decimal?         @db.Decimal(10, 2)
  brakeLining         BrakeLiningType?
  brakeClearing       Decimal?         @db.Decimal(10, 4)
  brakeClearanceTotal Decimal?         @db.Decimal(10, 4)
  brakeClearanceRear  Decimal?         @db.Decimal(10, 4)

  // Flywheel
  flywheelStoppingTime Decimal?              @db.Decimal(10, 2)
  flywheelBearings     FlywheelBearingsType?
  flywheelBrake        FlywheelBrakeType?

  // Rotary Union
  rotaryUnion RotaryUnionType?

  // Clutch details
  clutchEngagements Int?
  clutchLining      ClutchLiningType?
  clutchSeals       ClutchSealsType?

  // Gear and measurements (*Check only if excessive noise and/or vibration is present)
  gearBacklashBefore Decimal? @db.Decimal(10, 4)
  gearBacklashAfter  Decimal? @db.Decimal(10, 4)
  crankEndplayBefore Decimal? @db.Decimal(10, 4)
  crankEndplayAfter  Decimal? @db.Decimal(10, 4)

  // Air system
  airRegulatorValue   Decimal?                 @db.Decimal(10, 2)
  airRegulatorUnit    PressureUnit?
  airClutchTravel     Decimal?                 @db.Decimal(10, 4)
  airLineOilerSetting AirLineOilerSettingType?

  // Splines
  splinesDriveRingDisc SplinesConditionType?

  // Adjusting Nut/Lock
  adjustingNutLockSecure AdjustingNutLockType?

  // Hydraulic system
  hydClutchClearanceTotal Decimal?      @db.Decimal(10, 4)
  hydClutchClearanceRear  Decimal?      @db.Decimal(10, 4)
  hydraulicPressureValue  Decimal?      @db.Decimal(10, 2)
  hydraulicPressureUnit   PressureUnit?
  accumulatorValue        Decimal?      @db.Decimal(10, 2)
  accumulatorUnit         PressureUnit?

  // Separate Brake Seals
  separateBrakeSeals SeparateBrakeSealsType?

  // Flex Disc
  flexDisc FlexDiscType?

  // Notes
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services MachineServiceClutch[]

  @@map("service_data_clutch")
}

// COUNTERBALANCE_CYLINDER_AIRBAG Section

model MachineServiceCounterbalanceCylinderAirbag {
  id               String  @id @default(cuid())
  machineServiceId String
  outerDataId      String?
  innerDataId      String?

  machineService MachineService                    @relation(fields: [machineServiceId], references: [id], onDelete: Cascade)
  outerData      CounterbalanceCylinderAirbagData? @relation("OuterData", fields: [outerDataId], references: [id], onDelete: SetNull)
  innerData      CounterbalanceCylinderAirbagData? @relation("InnerData", fields: [innerDataId], references: [id], onDelete: SetNull)

  @@map("machine_service_counterbalance_cylinder_airbag")
}

model CounterbalanceCylinderAirbagData {
  id String @id @default(cuid())

  counterbalanceType CylinderAirbagType?

  // Airbag/Piston condition
  airbagPistonSeals             OkNaDncLeakingType?
  airbagPistonSealsLeakLocation String?

  // Regulator and gauges
  regulator OkNaDncNotOperationalType?
  gauge     OkNaDncNotOperationalType?

  // Pneumatics
  pneumaticsPlumbing OkNaDncNotOperationalLeakingType?

  // Rod condition
  rodSeals   OkNaDncLeakingType?
  rodBushing OkNaDncDarkOilType?

  // Oil
  oilWick OkNaDncNeedReplacedType?

  // Notes
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outerServices MachineServiceCounterbalanceCylinderAirbag[] @relation("OuterData")
  innerServices MachineServiceCounterbalanceCylinderAirbag[] @relation("InnerData")

  @@map("service_data_counterbalance_cylinder_airbag")
}

// TRAMMING Section

model MachineServiceTramming {
  id               String         @id @default(cuid())
  machineServiceId String
  outerDataId      String?
  innerDataId      String?
  slideTram        YesNoDncType?

  // Notes
  notes String?

  machineService MachineService @relation(fields: [machineServiceId], references: [id], onDelete: Cascade)
  outerData      TrammingData?  @relation("OuterData", fields: [outerDataId], references: [id], onDelete: SetNull)
  innerData      TrammingData?  @relation("InnerData", fields: [innerDataId], references: [id], onDelete: SetNull)

  @@map("machine_service_tramming")
}

model TrammingData {
  id String @id @default(cuid())

  // OUTER SECTION - Top Position (4 measurements around trim pin)
  outerTopTop    Decimal @db.Decimal(10, 4)
  outerTopBottom Decimal @db.Decimal(10, 4)
  outerTopLeft   Decimal @db.Decimal(10, 4)
  outerTopRight  Decimal @db.Decimal(10, 4)

  // OUTER SECTION - Bottom Position (4 measurements around trim pin)
  outerBottomTop    Decimal @db.Decimal(10, 4)
  outerBottomBottom Decimal @db.Decimal(10, 4)
  outerBottomLeft   Decimal @db.Decimal(10, 4)
  outerBottomRight  Decimal @db.Decimal(10, 4)

  // OUTER SECTION - Left Position (4 measurements around trim pin)
  outerLeftTop    Decimal @db.Decimal(10, 4)
  outerLeftBottom Decimal @db.Decimal(10, 4)
  outerLeftLeft   Decimal @db.Decimal(10, 4)
  outerLeftRight  Decimal @db.Decimal(10, 4)

  // OUTER SECTION - Right Position (4 measurements around trim pin)
  outerRightTop    Decimal @db.Decimal(10, 4)
  outerRightBottom Decimal @db.Decimal(10, 4)
  outerRightLeft   Decimal @db.Decimal(10, 4)
  outerRightRight  Decimal @db.Decimal(10, 4)

  // INNER SECTION - Top Position (4 measurements around trim pin)
  innerTopTop    Decimal @db.Decimal(10, 4)
  innerTopBottom Decimal @db.Decimal(10, 4)
  innerTopLeft   Decimal @db.Decimal(10, 4)
  innerTopRight  Decimal @db.Decimal(10, 4)

  // INNER SECTION - Bottom Position (4 measurements around trim pin)
  innerBottomTop    Decimal @db.Decimal(10, 4)
  innerBottomBottom Decimal @db.Decimal(10, 4)
  innerBottomLeft   Decimal @db.Decimal(10, 4)
  innerBottomRight  Decimal @db.Decimal(10, 4)

  // INNER SECTION - Left Position (4 measurements around trim pin)
  innerLeftTop    Decimal @db.Decimal(10, 4)
  innerLeftBottom Decimal @db.Decimal(10, 4)
  innerLeftLeft   Decimal @db.Decimal(10, 4)
  innerLeftRight  Decimal @db.Decimal(10, 4)

  // INNER SECTION - Right Position (4 measurements around trim pin)
  innerRightTop    Decimal @db.Decimal(10, 4)
  innerRightBottom Decimal @db.Decimal(10, 4)
  innerRightLeft   Decimal @db.Decimal(10, 4)
  innerRightRight  Decimal @db.Decimal(10, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outerServices MachineServiceTramming[] @relation("OuterData")
  innerServices MachineServiceTramming[] @relation("InnerData")

  @@map("service_data_tramming")
}
