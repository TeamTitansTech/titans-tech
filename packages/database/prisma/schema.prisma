  outerFreeHangingAfterInstall GibsStageData? @relation("OuterFreeHangingAfterInstall", fields: [outerFreeHangingAfterInstallId], references: [id], onDelete: SetNull)
  innerBeforeAdjustment        GibsStageData? @relation("InnerBeforeAdjustment", fields: [innerBeforeAdjustmentId], references: [id], onDelete: SetNull)
  innerAfterAdjustment         GibsStageData? @relation("InnerAfterAdjustment", fields: [innerAfterAdjustmentId], references: [id], onDelete: SetNull)
  innerBeforeToolInstallation  GibsStageData? @relation("InnerBeforeToolInstallation", fields: [innerBeforeToolInstallationId], references: [id], onDelete: SetNull)
  innerAfterToolInstallation   GibsStageData? @relation("InnerAfterToolInstallation", fields: [innerAfterToolInstallationId], references: [id], onDelete: SetNull)

  @@map("machine_service_gibs")
