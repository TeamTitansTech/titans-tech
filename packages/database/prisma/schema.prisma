model SysAdmin {
  id                     String   @id @default(cuid())
  email                  String   @unique
  password               String
  isUsingDefaultPassword Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("sys_admins")
}

model Company {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logo        String?
  loginLogo   String?
  brandColor  String?
  accentColor String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branches            CompanyBranch[]
  users               User[]
  permissionTemplates PermissionTemplate[]

  @@map("companies")
}

model PermissionTemplate {
  id          String  @id @default(cuid())
  name        String
  description String?
  permissions Json // Stores the Permissions object as JSON

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  @@map("permission_templates")
}

model CompanyBranch {
  id           String  @id @default(cuid())
  name         String
  isMainBranch Boolean @default(false)
  location     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company         Company          @relation(fields: [companyId], references: [id])
  companyId       String
  users           UserBranch[]
  machines        Machine[]
  productionLines ProductionLine[]

  @@map("company_branches")
}

model User {
  id                     String  @id @default(cuid())
  name                   String?
  email                  String  @unique
  password               String
  isCompanyAdmin         Boolean @default(false)
  isUsingDefaultPassword Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company              Company        @relation(fields: [companyId], references: [id])
  companyId            String
  branches             UserBranch[]
  notificationsCreated Notification[] @relation("NotificationsCreated")

  @@map("users")
}

model UserBranch {
  user      User          @relation(fields: [userId], references: [id])
  userId    String
  branch    CompanyBranch @relation(fields: [branchId], references: [id])
  branchId  String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // User Management Permissions
  readUsers             Boolean @default(false)
  createUsers           Boolean @default(false)
  updateUsers           Boolean @default(false)
  deleteUsers           Boolean @default(false)
  manageUserPermissions Boolean @default(false)
  assignUsersToBranches Boolean @default(false)

  // Branch Management Permissions
  readBranches   Boolean @default(false)
  updateBranches Boolean @default(false)

  // Machine Permissions
  readMachines   Boolean @default(false)
  createMachines Boolean @default(false)
  updateMachines Boolean @default(false)
  deleteMachines Boolean @default(false)

  // Service Permissions
  readServices   Boolean @default(false)
  createServices Boolean @default(false)
  updateServices Boolean @default(false)
  deleteServices Boolean @default(false)

  // Production Line Permissions
  readProductionLines   Boolean @default(false)
  createProductionLines Boolean @default(false)
  updateProductionLines Boolean @default(false)
  deleteProductionLines Boolean @default(false)

  @@id([userId, branchId])
  @@map("user_branches")
}

// Machine Management Models

model Blueprint {
  id        String           @id @default(cuid())
  name      String
  imageUrl  String?
  fields    Json // Array of { fieldName, fieldSlug, fieldType, fieldOptions? }
  sections  ServiceSection[] // Array of service sections
  deletedAt DateTime? // Soft delete to preserve historical data
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  machines                   Machine[]
  thresholdBearingClearance  ThresholdBearingClearance?
  thresholdClutch            ThresholdClutch?
  thresholdSlideSingleHammer ThresholdSlideSingleHammer?
  thresholdSlideDoubleHammer ThresholdSlideDoubleHammer?
  thresholdGibs              ThresholdGibs?
  thresholdPistons           ThresholdPistons?
  thresholdTramming          ThresholdTramming?

  @@map("blueprints")
}

model ThresholdBearingClearance {
  id          String @id @default(cuid())
  blueprintId String @unique

  // Total Clearance thresholds
  totalClearance_greenMin  Decimal @db.Decimal(10, 4)
  totalClearance_yellowMin Decimal @db.Decimal(10, 4)
  totalClearance_redMin    Decimal @db.Decimal(10, 4)

  // Main Bearings thresholds
  mainBearings_greenMin  Decimal @db.Decimal(10, 4)
  mainBearings_yellowMin Decimal @db.Decimal(10, 4)
  mainBearings_redMin    Decimal @db.Decimal(10, 4)

  // Upper Connection Bearings thresholds
  upperConnectionBearings_greenMin  Decimal @db.Decimal(10, 4)
  upperConnectionBearings_yellowMin Decimal @db.Decimal(10, 4)
  upperConnectionBearings_redMin    Decimal @db.Decimal(10, 4)

  // Wrist Pin to Mating Part thresholds
  wristPinToMatingPart_greenMin  Decimal @db.Decimal(10, 4)
  wristPinToMatingPart_yellowMin Decimal @db.Decimal(10, 4)
  wristPinToMatingPart_redMin    Decimal @db.Decimal(10, 4)

  // Wrist Pin to Bushing thresholds
  wristPinToBushing_greenMin  Decimal @db.Decimal(10, 4)
  wristPinToBushing_yellowMin Decimal @db.Decimal(10, 4)
  wristPinToBushing_redMin    Decimal @db.Decimal(10, 4)

  // Slide Adj Nut to Screw/Sleeve thresholds
  slideAdjNutToScrewSleeve_greenMin  Decimal @db.Decimal(10, 4)
  slideAdjNutToScrewSleeve_yellowMin Decimal @db.Decimal(10, 4)
  slideAdjNutToScrewSleeve_redMin    Decimal @db.Decimal(10, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blueprint Blueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)

  @@map("threshold_bearing_clearance")
}

model ThresholdClutch {
  id          String @id @default(cuid())
  blueprintId String @unique

  // Hyd Clutch Clearance Total thresholds
  hydClutchClearanceTotal_greenMin  Decimal @db.Decimal(10, 4)
  hydClutchClearanceTotal_yellowMin Decimal @db.Decimal(10, 4)
  hydClutchClearanceTotal_redMin    Decimal @db.Decimal(10, 4)

  // Hyd Clutch Clearance Rear thresholds
  hydClutchClearanceRear_greenMin  Decimal @db.Decimal(10, 4)
  hydClutchClearanceRear_yellowMin Decimal @db.Decimal(10, 4)
  hydClutchClearanceRear_redMin    Decimal @db.Decimal(10, 4)

  // F-B (Front-Back) thresholds
  fb_greenMin  Decimal @db.Decimal(10, 4)
  fb_yellowMin Decimal @db.Decimal(10, 4)
  fb_redMin    Decimal @db.Decimal(10, 4)

  // F-TB (Front Top-Bottom) thresholds
  fTB_greenMin  Decimal @db.Decimal(10, 4)
  fTB_yellowMin Decimal @db.Decimal(10, 4)
  fTB_redMin    Decimal @db.Decimal(10, 4)

  // R-TB (Rear Top-Bottom) thresholds
  rTB_greenMin  Decimal @db.Decimal(10, 4)
  rTB_yellowMin Decimal @db.Decimal(10, 4)
  rTB_redMin    Decimal @db.Decimal(10, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blueprint Blueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)

  @@map("threshold_clutch")
}

model ThresholdSlideSingleHammer {
  id          String @id @default(cuid())
  blueprintId String @unique

  // Max Deviation thresholds (single threshold for both outer and inner)
  maxDeviation_greenMin  Decimal @db.Decimal(10, 4)
  maxDeviation_yellowMin Decimal @db.Decimal(10, 4)
  maxDeviation_redMin    Decimal @db.Decimal(10, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blueprint Blueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)

  @@map("threshold_slide_single_hammer")
}

model ThresholdSlideDoubleHammer {
  id          String @id @default(cuid())
  blueprintId String @unique

  // Max Deviation thresholds (single threshold for both outer and inner)
  maxDeviation_greenMin  Decimal @db.Decimal(10, 4)
  maxDeviation_yellowMin Decimal @db.Decimal(10, 4)
  maxDeviation_redMin    Decimal @db.Decimal(10, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blueprint Blueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)

  @@map("threshold_slide_double_hammer")
}

model ThresholdGibs {
  id          String @id @default(cuid())
  blueprintId String @unique

  // Usable thresholds (single field with green/yellow/red levels)
  usable_greenMin  Decimal @db.Decimal(10, 4)
  usable_yellowMin Decimal @db.Decimal(10, 4)
  usable_redMin    Decimal @db.Decimal(10, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blueprint Blueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)

  @@map("threshold_gibs")
}

model ThresholdPistons {
  id          String @id @default(cuid())
  blueprintId String @unique

  // Difference thresholds (for side-to-side differences)
  difference_greenMin  Decimal @db.Decimal(10, 4)
  difference_yellowMin Decimal @db.Decimal(10, 4)
  difference_redMin    Decimal @db.Decimal(10, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blueprint Blueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)

  @@map("threshold_pistons")
}

model ThresholdTramming {
  id          String @id @default(cuid())
  blueprintId String @unique

  // Single threshold range for all tramming sums (vertical and horizontal)
  greenMin  Decimal @db.Decimal(10, 4)
  yellowMin Decimal @db.Decimal(10, 4)
  redMin    Decimal @db.Decimal(10, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blueprint Blueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)

  @@map("threshold_tramming")
}

model Machine {
  id          String  @id @default(cuid())
  blueprintId String
  branchId    String
  name        String // Machine name/identifier
  imageUrl    String? // URL to machine image (S3 or external)

  // Machine specifications
  manufacturer    String?
  sizeTonnage     String?
  serialNumber    String?
  stroke          String?
  foundationType  FoundationType?
  frameType       FrameType?
  clutchType      MachineClutchType?
  pneumaticSystem PneumaticSystemType?
  pressMounting   PressMountingType?
  features        MachineFeaturesType?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blueprint       Blueprint               @relation(fields: [blueprintId], references: [id], onDelete: Restrict)
  branch          CompanyBranch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  fields          MachineField[]
  services        MachineService[]
  serviceRequests ServiceRequest[]
  emails          Email[]
  productionLines MachineProductionLine[]

  @@map("machines")
}

model MachineField {
  id        String   @id @default(cuid())
  machineId String
  fieldSlug String
  value     String // Store as string, convert based on fieldType from blueprint
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@unique([machineId, fieldSlug])
  @@map("machine_fields")
}

// Machine Service Models

model MachineService {
  id                 String        @id @default(cuid())
  machineId          String
  serviceRequestId   String? // Optional: if created from a service request
  date               DateTime
  type               ServiceType   @default(INSPECTION)
  status             ServiceStatus @default(PENDING)
  performedBy        String? // Optional: userId of who performed the service
  notes              String?       @db.Text // Additional notes/comments for the service
  completedSections  Json?         @default("[]") // Array of completed section keys
  lastSectionSavedAt DateTime? // Timestamp of last section save
  currentStep        String? // Current step in the modal: 'selection', 'details', 'sections', 'summary'
  currentSectionKey  String? // Current section being filled (e.g., 'BEARING_CLEARANCE')
  selectedSections   Json?         @default("[]") // Array of selected section keys

  // Inspection observation fields
  isPressLevel                YesNoNaDncType?
  driveBeltCondition          DriveBeltConditionType?
  areAllProtectiveCovers      ProtectiveCoversStatusType?
  protectiveCoversExplanation String?
  areCracksVisible            YesNoDncType?
  cracksLocation              String?
  isMainMotorSecure           YesNoDncType?
  isMotorPlateSecure          YesNoDncType?
  whyNotCovered               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  machine                           Machine                                      @relation(fields: [machineId], references: [id], onDelete: Cascade)
  serviceRequest                    ServiceRequest?                              @relation(fields: [serviceRequestId], references: [id], onDelete: SetNull)
  bearingClearance                  MachineServiceBearingClearance[]
  slide                             MachineServiceSlide[] // DEPRECATED: Use slideSingleHammer and slideDoubleHammer
  slideSingleHammer                 MachineServiceSlideSingleHammer[]
  slideDoubleHammer                 MachineServiceSlideDoubleHammer[]
  gibs                              MachineServiceGibs[]
  lubricationHydraulics             MachineServiceLubricationHydraulics[]
  clutch                            MachineServiceClutch[]
  counterbalanceCylinderAirbag      MachineServiceCounterbalanceCylinderAirbag[]
  tramming                          MachineServiceTramming[]
  pistons                           MachineServicePistons[]
  alertBearingClearance             AlertBearingClearance[]
  alertCounterbalanceCylinderAirbag AlertCounterbalanceCylinderAirbag[]
  alertClutch                       AlertClutch[]
  alertSlide                        AlertSlide[] // DEPRECATED: Use alertSlideSingleHammer and alertSlideDoubleHammer
  alertSlideSingleHammer            AlertSlideSingleHammer[]
  alertSlideDoubleHammer            AlertSlideDoubleHammer[]
  alertGibs                         AlertGibs[]
  alertPistons                      AlertPistons[]
  alertTramming                     AlertTramming[]

  @@index([serviceRequestId])
  @@map("machine_services")
}

model AlertBearingClearance {
  id               String @id @default(cuid())
  machineServiceId String

  // OUTER alerts
  outer_totalClearance_differential           Decimal       @db.Decimal(10, 4)
  outer_totalClearance_severity               AlertSeverity
  outer_mainBearings_differential             Decimal       @db.Decimal(10, 4)
  outer_mainBearings_severity                 AlertSeverity
  outer_upperConnectionBearings_differential  Decimal       @db.Decimal(10, 4)
  outer_upperConnectionBearings_severity      AlertSeverity
  outer_wristPinToMatingPart_differential     Decimal       @db.Decimal(10, 4)
  outer_wristPinToMatingPart_severity         AlertSeverity
  outer_wristPinToBushing_differential        Decimal       @db.Decimal(10, 4)
  outer_wristPinToBushing_severity            AlertSeverity
  outer_slideAdjNutToScrewSleeve_differential Decimal       @db.Decimal(10, 4)
  outer_slideAdjNutToScrewSleeve_severity     AlertSeverity

  // INNER alerts
  inner_totalClearance_differential           Decimal       @db.Decimal(10, 4)
  inner_totalClearance_severity               AlertSeverity
  inner_mainBearings_differential             Decimal       @db.Decimal(10, 4)
  inner_mainBearings_severity                 AlertSeverity
  inner_upperConnectionBearings_differential  Decimal       @db.Decimal(10, 4)
  inner_upperConnectionBearings_severity      AlertSeverity
  inner_wristPinToMatingPart_differential     Decimal       @db.Decimal(10, 4)
  inner_wristPinToMatingPart_severity         AlertSeverity
  inner_wristPinToBushing_differential        Decimal       @db.Decimal(10, 4)
  inner_wristPinToBushing_severity            AlertSeverity
  inner_slideAdjNutToScrewSleeve_differential Decimal       @db.Decimal(10, 4)
  inner_slideAdjNutToScrewSleeve_severity     AlertSeverity

  // Optional snapshot of thresholds used in calculation (for auditing)
  thresholdSnapshot Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  machineService MachineService @relation(fields: [machineServiceId], references: [id], onDelete: Cascade)

  @@index([machineServiceId])
  @@map("alert_bearing_clearance")
}

model AlertCounterbalanceCylinderAirbag {
  id               String                   @id @default(cuid())
  machineServiceId String
  fieldName        CounterbalanceAlertField
  justification    String                   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  machineService MachineService @relation(fields: [machineServiceId], references: [id], onDelete: Cascade)

  @@unique([machineServiceId, fieldName])
  @@map("alert_counterbalance_cylinder_airbag")
}

model AlertClutch {
  id               String @id @default(cuid())
  machineServiceId String

  // Hyd Clutch Clearance Total alert
  hydClutchClearanceTotal_value    Decimal       @db.Decimal(10, 4)
  hydClutchClearanceTotal_severity AlertSeverity

  // Hyd Clutch Clearance Rear alert
  hydClutchClearanceRear_value    Decimal       @db.Decimal(10, 4)
  hydClutchClearanceRear_severity AlertSeverity

  // F-B (Front-Back) alert
  fb_value    Decimal       @db.Decimal(10, 4)
  fb_severity AlertSeverity

  // F-TB (Front Top-Bottom) alert
  fTB_value    Decimal       @db.Decimal(10, 4)
  fTB_severity AlertSeverity

  // R-TB (Rear Top-Bottom) alert
  rTB_value    Decimal       @db.Decimal(10, 4)
  rTB_severity AlertSeverity

  // Optional snapshot of thresholds used in calculation (for auditing)
  thresholdSnapshot Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  machineService MachineService @relation(fields: [machineServiceId], references: [id], onDelete: Cascade)

  @@index([machineServiceId])
  @@map("alert_clutch")
}

// DEPRECATED: Use AlertSlideSingleHammer and AlertSlideDoubleHammer instead
model AlertSlide {
  id               String @id @default(cuid())
  machineServiceId String

  // Outer Max Deviation alert
  maxDeviationOuter_differential Decimal       @db.Decimal(10, 4)
  maxDeviationOuter_severity     AlertSeverity

  // Inner Max Deviation alert
  maxDeviationInner_differential Decimal       @db.Decimal(10, 4)
  maxDeviationInner_severity     AlertSeverity

  // Optional snapshot of thresholds used in calculation (for auditing)
  thresholdSnapshot Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  machineService MachineService @relation(fields: [machineServiceId], references: [id], onDelete: Cascade)

  @@index([machineServiceId])
  @@map("alert_slide")
}

// Alert for Single Hammer Slide (only has one set of measurements)
model AlertSlideSingleHammer {
  id               String @id @default(cuid())
  machineServiceId String

  // Max Deviation alert (single hammer only has one measurement set)
  maxDeviation_differential Decimal       @db.Decimal(10, 4)
  maxDeviation_severity     AlertSeverity

  // Optional snapshot of thresholds used in calculation (for auditing)
  thresholdSnapshot Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  machineService MachineService @relation(fields: [machineServiceId], references: [id], onDelete: Cascade)

  @@index([machineServiceId])
  @@map("alert_slide_single_hammer")
}

// Alert for Double Hammer Slide (has outer and inner measurements)
model AlertSlideDoubleHammer {
  id               String @id @default(cuid())
  machineServiceId String

  // Outer Max Deviation alert
  maxDeviationOuter_differential Decimal       @db.Decimal(10, 4)
  maxDeviationOuter_severity     AlertSeverity

  // Inner Max Deviation alert
  maxDeviationInner_differential Decimal       @db.Decimal(10, 4)
  maxDeviationInner_severity     AlertSeverity

  // Optional snapshot of thresholds used in calculation (for auditing)
  thresholdSnapshot Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  machineService MachineService @relation(fields: [machineServiceId], references: [id], onDelete: Cascade)

