  leftLeft   Decimal @db.Decimal(10, 4)
  leftRight  Decimal @db.Decimal(10, 4)

  // Right Position (4 measurements around trim pin)
  rightTop    Decimal @db.Decimal(10, 4)
  rightBottom Decimal @db.Decimal(10, 4)
  rightLeft   Decimal @db.Decimal(10, 4)
  rightRight  Decimal @db.Decimal(10, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outerServices MachineServiceTramming[] @relation("OuterData")
  innerServices MachineServiceTramming[] @relation("InnerData")

  @@map("service_data_tramming")
}

model MachineServicePistons {
  id               String  @id @default(cuid())
  machineServiceId String
  outerDataId      String?
  innerDataId      String?

  // Top-level fields
  guideSeals                     SealConditionType?
  pistonSeals                    SealConditionType?
  vacuumSystem                   VacuumSystemConditionType?
  vacuumSystemAirPressureSetting Decimal?                   @db.Decimal(10, 4)

  // Notes
  notes String?

  machineService MachineService @relation(fields: [machineServiceId], references: [id], onDelete: Cascade)
  outerData      PistonsData?   @relation("OuterData", fields: [outerDataId], references: [id], onDelete: SetNull)
  innerData      PistonsData?   @relation("InnerData", fields: [innerDataId], references: [id], onDelete: SetNull)

  @@map("machine_service_pistons")
}

model PistonsData {
  id String @id @default(cuid())

  // LH Piston (4 measurements around piston)
  lhTop    Decimal @db.Decimal(10, 4)
  lhBottom Decimal @db.Decimal(10, 4)
  lhLeft   Decimal @db.Decimal(10, 4)
  lhRight  Decimal @db.Decimal(10, 4)

  // RH Piston (4 measurements around piston)
  rhTop    Decimal @db.Decimal(10, 4)
  rhBottom Decimal @db.Decimal(10, 4)
  rhLeft   Decimal @db.Decimal(10, 4)
  rhRight  Decimal @db.Decimal(10, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outerServices MachineServicePistons[] @relation("OuterData")
  innerServices MachineServicePistons[] @relation("InnerData")

  @@map("service_data_pistons")
}

// Production Line Models

model ProductionLine {
  id        String                  @id @default(cuid())
  name      String
  branchId  String
  createdBy String?
  direction ProductionLineDirection @default(LEFT_TO_RIGHT)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  branch   CompanyBranch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  machines MachineProductionLine[]

  @@map("production_lines")
}

model MachineProductionLine {
  machineId        String
  productionLineId String
  order            Int
  addedAt          DateTime @default(now())

  machine        Machine        @relation(fields: [machineId], references: [id], onDelete: Cascade)
  productionLine ProductionLine @relation(fields: [productionLineId], references: [id], onDelete: Cascade)

  @@id([machineId, productionLineId])
  @@map("machine_production_lines")
}

// Service Request - Public QR code maintenance requests
model ServiceRequest {
  id        String               @id @default(cuid())
  machineId String
  status    ServiceRequestStatus @default(OPEN)

  // Requester information
  requesterName  String
  requesterEmail String
  requesterPhone String?

  // Problem description
  problemDescription String  @db.Text
  imageUrl           String? // Optional image uploaded by requester

  // Device tracking information
  ipAddress  String?
  userAgent  String? @db.Text
  browser    String?
  os         String?
  deviceType String?
  isMobile   Boolean @default(false)

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  // Relations
  machine  Machine          @relation(fields: [machineId], references: [id], onDelete: Cascade)
  services MachineService[] // Services created from this request

  @@index([machineId])
  @@index([status])
  @@index([createdAt])
  @@map("service_requests")
}
