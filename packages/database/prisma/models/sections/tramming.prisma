// Tramming section-specific enums

enum DncToBedToBolsterType {
  DNC
  TO_BED
  TO_BOLSTER
}

// Service section model

model MachineServiceTramming {
  id               String                 @id @default(cuid())
  machineServiceId String
  outerDataId      String?
  innerDataId      String?
  slideTram        DncToBedToBolsterType?

  // Notes
  notes String?

  machineService MachineService @relation(fields: [machineServiceId], references: [id], onDelete: Cascade)
  outerData      TrammingData?  @relation("OuterData", fields: [outerDataId], references: [id], onDelete: SetNull)
  innerData      TrammingData?  @relation("InnerData", fields: [innerDataId], references: [id], onDelete: SetNull)

  @@map("machine_service_tramming")
}

// Data model

model TrammingData {
  id String @id @default(cuid())

  // Top Position (4 measurements around trim pin)
  topTop    Decimal @db.Decimal(10, 4)
  topBottom Decimal @db.Decimal(10, 4)
  topLeft   Decimal @db.Decimal(10, 4)
  topRight  Decimal @db.Decimal(10, 4)

  // Bottom Position (4 measurements around trim pin)
  bottomTop    Decimal @db.Decimal(10, 4)
  bottomBottom Decimal @db.Decimal(10, 4)
  bottomLeft   Decimal @db.Decimal(10, 4)
  bottomRight  Decimal @db.Decimal(10, 4)

  // Left Position (4 measurements around trim pin)
  leftTop    Decimal @db.Decimal(10, 4)
  leftBottom Decimal @db.Decimal(10, 4)
  leftLeft   Decimal @db.Decimal(10, 4)
  leftRight  Decimal @db.Decimal(10, 4)

  // Right Position (4 measurements around trim pin)
  rightTop    Decimal @db.Decimal(10, 4)
  rightBottom Decimal @db.Decimal(10, 4)
  rightLeft   Decimal @db.Decimal(10, 4)
  rightRight  Decimal @db.Decimal(10, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outerServices MachineServiceTramming[] @relation("OuterData")
  innerServices MachineServiceTramming[] @relation("InnerData")

  @@map("service_data_tramming")
}
