# SST Environment Variables
# Copy this file to .env.sst and fill in your values

# Database
DATABASE_USERNAME=titans_admin
DATABASE_PASSWORD=your_secure_password_here

# JWT
JWT_SECRET=your_jwt_secret_key_here

# S3
S3_BUCKET=titans-tech-uploads

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password

# Google Analytics (Production only)
GA_TRACKING_ID=G-XXXXXXXXXX

# Sentry Error Tracking
SENTRY_DSN_FRONTEND=https://your_sentry_dsn@sentry.io/frontend
SENTRY_DSN_BACKEND=https://your_sentry_dsn@sentry.io/backend

# Stripe Payment
STRIPE_PUBLIC_KEY=pk_test_XXXXXXXXXX
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXX

# Google Maps
GOOGLE_MAPS_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXX

# AWS Configuration (usually set automatically by SST)
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# Domain Configuration (for production)
DOMAIN=titans-tech.com
CERTIFICATE_ARN=arn:aws:acm:us-east-1:123456789012:certificate/xxxxx