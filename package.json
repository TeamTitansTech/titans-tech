{
  "name": "titans-tech",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "postinstall": "(cd packages/database && npm run db:generate && npm run build) && npm run install:hooks",
    "install:hooks": "bash scripts/install-git-hooks.sh",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f postgres",
    "docker:restart": "docker compose restart postgres",
    "docker:clean": "docker compose down -v",
    "db:setup": "npm run docker:up && sleep 3 && cd packages/database && npm run db:generate && npm run build && npm run db:push && npm run db:seed"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "doctrine": "^2.1.0",
    "eslint": "^9.0.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "jsx-ast-utils": "^3.3.5",
    "next": "16.0.1",
    "prettier": "^3.3.0",
    "turbo": "^2.6.0",
    "typescript": "^5.6.0"
  },
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=18.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@radix-ui/react-icons": "^1.3.2"
  }
}
