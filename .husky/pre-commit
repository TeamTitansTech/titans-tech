#!/bin/sh

# Colors for output
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo "${YELLOW}🎨 Formatting staged files...${NC}"
echo ""

# Run lint-staged to format staged files
# This runs Prettier on TS/TSX/MD/JSON files and Prisma format on schema
npx lint-staged

echo ""
echo "${GREEN}✅ Code formatted successfully!${NC}"
