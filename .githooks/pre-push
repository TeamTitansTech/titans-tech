#!/bin/bash

# Pre-push hook to prevent direct pushes to main branch
# This hook is called by "git push" and can be bypassed with --no-verify

protected_branch="main"
current_branch=$(git symbolic-ref HEAD | sed -e 's,.*/\(.*\),\1,')

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Only check if pushing to protected branch
if [ "$current_branch" = "$protected_branch" ]; then
    # Get the latest commit message
    commit_msg=$(git log -1 --pretty=%B)

    # Check for bypass flag in commit message
    if echo "$commit_msg" | grep -q "\[allow-direct-push\]"; then
        echo -e "${GREEN}✅ Bypass flag detected: [allow-direct-push]${NC}"
        echo -e "${YELLOW}⚠️  Allowing direct push to main branch${NC}"
        exit 0
    fi

    # Block the push
    echo -e "${RED}╔════════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${RED}║                     🚫 PUSH BLOCKED 🚫                         ║${NC}"
    echo -e "${RED}╚════════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    echo -e "${RED}❌ Direct push to '${protected_branch}' branch is not allowed!${NC}"
    echo ""
    echo -e "Please use one of the following methods:"
    echo ""
    echo -e "  ${GREEN}1. Create a pull request (recommended):${NC}"
    echo -e "     git checkout -b feature/my-feature"
    echo -e "     git push origin feature/my-feature"
    echo -e "     # Then create a PR on GitHub"
    echo ""
    echo -e "  ${YELLOW}2. Emergency bypass (use with caution):${NC}"
    echo -e "     git commit --amend -m 'Your message [allow-direct-push]'"
    echo -e "     git push origin main"
    echo ""
    echo -e "  ${YELLOW}3. Skip this hook (not recommended):${NC}"
    echo -e "     git push --no-verify"
    echo ""
    echo -e "Current branch: ${YELLOW}${current_branch}${NC}"
    echo -e "Latest commit: ${commit_msg}"
    echo ""

    exit 1
fi

# Allow push to other branches
exit 0
